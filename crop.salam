// lang: en

package main

import os.shell
import str
import conv
import math

include util "util.salam"
include types "types.salam"

pub func cm_to_px(cm: f64, dpi: i64): int:
    px := (cm * (dpi as f64) / 2.54) as int
    if px < 0:
        ret 0
    end
    ret px
end

pub func detect_crop(input_path: str, ffmpeg: str, start: f64, duration: f64): types.CropRect throws:
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push("-hide_banner")
    args.push("-loglevel")
    args.push("info")
    args.push("-ss")
    args.push(util.seconds(start))
    args.push("-t")
    args.push(util.seconds(duration))
    args.push("-i")
    args.push(input_path)
    args.push("-vf")
    args.push("cropdetect=limit=24:round=2")
    args.push("-an")
    args.push("-f")
    args.push("null")
    args.push("-")

    r := shell.Run(ffmpeg, args)
    mut text := r.err
    if text.len() == 0:
        text = r.out
    end
    if r.code == 0 - 1:
        throw Error.New(ErrorKind.NotFound, "Could not find '".concat(ffmpeg).concat("'."))
    end

    // Find last crop=W:H:X:Y occurrence
    mut last := ""
    mut i := 0
    until i < text.len():
        mut is_crop := false
        if i + 5 <= text.len() and text.substr(i, 5) == "crop=":
            is_crop = true
        end
        if is_crop:
            mut j := i + 5
            mut val := ""
            until j < text.len():
                c := text.substr(j, 1)
                if c == " " or c == "\n" or c == "\r" or c == "\t" or c == "]":
                    break
                end
                val = val.concat(c)
                j++
            end
            if val.len() > 0:
                last = val
            end
            i = j
        else:
            i++
        end
    end

    if last.len() == 0:
        throw Error.New(ErrorKind.Internal, "cropdetect did not produce a crop value.")
    end

    // parse W:H:X:Y
    mut parts := Vector {} as Vector<str>
    defer parts.free()
    mut k := 0
    mut cur := ""
    until k < last.len():
        c := last.substr(k, 1)
        if c == ":":
            parts.push(cur)
            cur = ""
        else:
            cur = cur.concat(c)
        end
        k++
    end
    parts.push(cur)
    if parts.len() < 4:
        throw Error.New(ErrorKind.Internal, "Could not parse crop value: ".concat(last))
    end

    w := conv.ParseIntOr(parts.get(0), 0) as int
    h := conv.ParseIntOr(parts.get(1), 0) as int
    x := conv.ParseIntOr(parts.get(2), 0) as int
    y := conv.ParseIntOr(parts.get(3), 0) as int
    if w <= 0 or h <= 0:
        throw Error.New(ErrorKind.Internal, "Invalid crop dimensions: ".concat(last))
    end

    ret types.CropRect { w = w, h = h, x = x, y = y }
end

pub func rect_equal(a: types.CropRect, b: types.CropRect): bool:
    ret a.w == b.w and a.h == b.h and a.x == b.x and a.y == b.y
end

pub func detect_segments(input_path: str, ffmpeg: str, trim_start: f64, main_duration: f64, first_min: f64, last_min: f64, first_pad: int, last_pad: int): Vector<types.CropSegment> throws:
    mut segs := Vector {} as Vector<types.CropSegment>
    interval := 30.0
    sample_dur := 4.0
    mut t := 0.0

    first_end := math.Min(first_min, main_duration)
    mut last_start := main_duration - last_min
    if last_start < 0.0:
        last_start = 0.0
    end
    if last_start < first_end:
        last_start = first_end
    end

    until t < main_duration:
        mut seg_dur := interval
        if t + seg_dur > main_duration:
            seg_dur = main_duration - t
        end
        mut sdur := sample_dur
        if sdur > seg_dur:
            sdur = seg_dur
        end
        if sdur < 1.0:
            sdur = seg_dur
        end
        sample_start := trim_start + t
        rect := try detect_crop(input_path, ffmpeg, sample_start, sdur)

        mut pad := 0
        if t < first_end:
            pad = first_pad
        end
        if t >= last_start:
            pad = last_pad
        end

        mut merged := false
        if segs.len() > 0:
            last_i := segs.len() - 1
            prev := segs.get(last_i)
            if rect_equal(prev.rect, rect) and prev.pad == pad:
                prev.duration += seg_dur
                segs.set(last_i, prev)
                merged = true
            end
        end
        if not merged:
            segs.push(types.CropSegment { offset = t, duration = seg_dur, rect = rect, pad = pad })
        end
        t += seg_dur
    end

    if segs.len() == 0:
        rect := try detect_crop(input_path, ffmpeg, trim_start, math.Min(main_duration, 5.0))
        segs.push(types.CropSegment { offset = 0.0, duration = main_duration, rect = rect, pad = 0 })
    end
    ret segs
end
