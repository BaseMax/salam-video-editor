// lang: en

package main

import str
import conv

include util "util.salam"

pub func append_image_video(graph &: Vector<str>, video_parts &: Vector<str>, index: int, label: str, output_width: int, output_height: int, fps_expr: str, frame_timebase_expr: str):
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "[")
    str.BufAppend(sb, conv.FormatInt(index as i64))
    str.BufAppend(sb, ":v:0]scale=")
    str.BufAppend(sb, conv.FormatInt(output_width as i64))
    str.BufAppend(sb, ":")
    str.BufAppend(sb, conv.FormatInt(output_height as i64))
    str.BufAppend(sb, ":force_original_aspect_ratio=decrease:flags=lanczos,pad=")
    str.BufAppend(sb, conv.FormatInt(output_width as i64))
    str.BufAppend(sb, ":")
    str.BufAppend(sb, conv.FormatInt(output_height as i64))
    str.BufAppend(sb, ":(ow-iw)/2:(oh-ih)/2:color=black,setsar=1,fps=")
    str.BufAppend(sb, fps_expr)
    str.BufAppend(sb, ",settb=expr=")
    str.BufAppend(sb, frame_timebase_expr)
    str.BufAppend(sb, ",setpts=N,format=yuv420p[")
    str.BufAppend(sb, label)
    str.BufAppend(sb, "]")
    graph.push(str.BufStr(sb))
    video_parts.push("[".concat(label).concat("]"))
end

pub func build_filter_graph(main_index: int, has_intro: bool, intro_index: int, has_outro: bool, outro_index: int, intro_duration: f64, outro_duration: f64, trim_start: f64, main_duration: f64, output_width: int, output_height: int, fps_expr: str, frame_timebase_expr: str, has_audio: bool): str:
    mut graph := Vector {} as Vector<str>
    mut video_parts := Vector {} as Vector<str>
    mut audio_parts := Vector {} as Vector<str>

    if has_intro:
        append_image_video(graph, video_parts, intro_index, "intro_v", output_width, output_height, fps_expr, frame_timebase_expr)
    end

    mut main_sb := str.NewBuilder()
    defer str.BufFree(main_sb)
    str.BufAppend(main_sb, "[")
    str.BufAppend(main_sb, conv.FormatInt(main_index as i64))
    str.BufAppend(main_sb, ":v:0]trim=start=")
    str.BufAppend(main_sb, util.seconds(trim_start))
    str.BufAppend(main_sb, ":duration=")
    str.BufAppend(main_sb, util.seconds(main_duration))
    str.BufAppend(main_sb, ",setpts=PTS-STARTPTS,scale=")
    str.BufAppend(main_sb, conv.FormatInt(output_width as i64))
    str.BufAppend(main_sb, ":")
    str.BufAppend(main_sb, conv.FormatInt(output_height as i64))
    str.BufAppend(main_sb, ":force_original_aspect_ratio=decrease:flags=lanczos,pad=")
    str.BufAppend(main_sb, conv.FormatInt(output_width as i64))
    str.BufAppend(main_sb, ":")
    str.BufAppend(main_sb, conv.FormatInt(output_height as i64))
    str.BufAppend(main_sb, ":(ow-iw)/2:(oh-ih)/2:color=black,setsar=1,fps=")
    str.BufAppend(main_sb, fps_expr)
    str.BufAppend(main_sb, ",settb=expr=")
    str.BufAppend(main_sb, frame_timebase_expr)
    str.BufAppend(main_sb, ",setpts=N,format=yuv420p[main_v]")
    graph.push(str.BufStr(main_sb))
    video_parts.push("[main_v]")

    if has_outro:
        append_image_video(graph, video_parts, outro_index, "outro_v", output_width, output_height, fps_expr, frame_timebase_expr)
    end

    if video_parts.len() == 1:
        graph.push(video_parts.get(0).concat("null[out_v]"))
    else:
        mut vconcat_sb := str.NewBuilder()
        defer str.BufFree(vconcat_sb)
        mut vi := 0
        until vi < video_parts.len():
            str.BufAppend(vconcat_sb, video_parts.get(vi))
            vi++
        end
        str.BufAppend(vconcat_sb, "concat=n=")
        str.BufAppend(vconcat_sb, conv.FormatInt(video_parts.len() as i64))
        str.BufAppend(vconcat_sb, ":v=1:a=0[out_v]")
        graph.push(str.BufStr(vconcat_sb))
    end

    if has_audio:
        if has_intro:
            mut intro_a_sb := str.NewBuilder()
            defer str.BufFree(intro_a_sb)
            str.BufAppend(intro_a_sb, "anullsrc=r=48000:cl=stereo,atrim=duration=")
            str.BufAppend(intro_a_sb, util.seconds(intro_duration))
            str.BufAppend(intro_a_sb, ",asetpts=PTS-STARTPTS[intro_a]")
            graph.push(str.BufStr(intro_a_sb))
            audio_parts.push("[intro_a]")
        end

        mut main_a_sb := str.NewBuilder()
        defer str.BufFree(main_a_sb)
        str.BufAppend(main_a_sb, "[")
        str.BufAppend(main_a_sb, conv.FormatInt(main_index as i64))
        str.BufAppend(main_a_sb, ":a:0]atrim=start=")
        str.BufAppend(main_a_sb, util.seconds(trim_start))
        str.BufAppend(main_a_sb, ":duration=")
        str.BufAppend(main_a_sb, util.seconds(main_duration))
        str.BufAppend(main_a_sb, ",asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,apad,atrim=duration=")
        str.BufAppend(main_a_sb, util.seconds(main_duration))
        str.BufAppend(main_a_sb, ",asetpts=PTS-STARTPTS[main_a]")
        graph.push(str.BufStr(main_a_sb))
        audio_parts.push("[main_a]")

        if has_outro:
            mut outro_a_sb := str.NewBuilder()
            defer str.BufFree(outro_a_sb)
            str.BufAppend(outro_a_sb, "anullsrc=r=48000:cl=stereo,atrim=duration=")
            str.BufAppend(outro_a_sb, util.seconds(outro_duration))
            str.BufAppend(outro_a_sb, ",asetpts=PTS-STARTPTS[outro_a]")
            graph.push(str.BufStr(outro_a_sb))
            audio_parts.push("[outro_a]")
        end

        if audio_parts.len() == 1:
            graph.push(audio_parts.get(0).concat("anull[out_a]"))
        else:
            mut aconcat_sb := str.NewBuilder()
            defer str.BufFree(aconcat_sb)
            mut aai := 0
            until aai < audio_parts.len():
                str.BufAppend(aconcat_sb, audio_parts.get(aai))
                aai++
            end
            str.BufAppend(aconcat_sb, "concat=n=")
            str.BufAppend(aconcat_sb, conv.FormatInt(audio_parts.len() as i64))
            str.BufAppend(aconcat_sb, ":v=0:a=1[out_a]")
            graph.push(str.BufStr(aconcat_sb))
        end
    end

    ret str.Join(graph, ";")
end
