// lang: en

package main

import os
import os.shell
import str
import conv
import fs.path

pub func expand_path(p: str): str:
    if str.StartsWith(p, "~"):
        mut home := os.Env("HOME")
        if home.len() == 0:
            home = os.Env("USERPROFILE")
        end
        if p == "~":
            ret home
        end
        if str.StartsWith(p, "~/") or str.StartsWith(p, "~\\"):
            rest := p.substr(2, p.len() - 2)
            ret path.Join(home, rest)
        end
    end
    ret p
end

pub func run_capture(program: str, args: Vector<str>): str throws:
    r := shell.Run(program, args)
    if r.code == 0 - 1:
        throw Error.New(ErrorKind.NotFound, "Could not find '".concat(program).concat("'. Install FFmpeg (including ffprobe) and make sure both programs are on PATH."))
    end
    if r.code != 0:
        mut details := r.err
        if details.len() == 0:
            details = r.out
        end
        if details.len() == 0:
            details = "command failed"
        end
        throw Error.New(ErrorKind.Internal, details)
    end
    ret r.out
end

pub func seconds(value: f64): str:
    mut res := conv.FormatFloatPrec(value, 6)
    mut done := false
    until done:
        if res.len() > 0 and res.char_at(res.len() - 1) == "0":
            res = res.substr(0, res.len() - 1)
        else:
            done = true
        end
    end
    if res.len() > 0 and res.char_at(res.len() - 1) == ".":
        res = res.substr(0, res.len() - 1)
    end
    if res.len() == 0:
        res = "0"
    end
    ret res
end


pub func even_dimension(value: f64): int:
    result := (value as int) / 2 * 2
    if result < 2:
        ret 2
    end
    ret result
end

pub func tool_exists(program: str): bool:
    mut args := Vector {} as Vector<str>
    args.push("-version")
    r := shell.Run(program, args)
    ret r.code != 0 - 1
end

pub func missing_tool_message(program: str): str:
    mut msg := "ERROR: '".concat(program).concat("' was not found on PATH.\n")
    msg = msg.concat("Install FFmpeg (it provides both ffmpeg and ffprobe) for your OS:\n")
    msg = msg.concat("  Windows:  winget install Gyan.FFmpeg   (or download from https://ffmpeg.org/download.html and add the bin folder to PATH)\n")
    msg = msg.concat("  macOS:    brew install ffmpeg\n")
    msg = msg.concat("  Linux:    sudo apt install ffmpeg   (Debian/Ubuntu)  |  sudo dnf install ffmpeg  (Fedora)  |  sudo pacman -S ffmpeg  (Arch)\n")
    msg = msg.concat("  FreeBSD:  sudo pkg install ffmpeg\n")
    msg = msg.concat("Then reopen your terminal and try again.\n")
    ret msg
end
